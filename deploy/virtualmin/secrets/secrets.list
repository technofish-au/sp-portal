# Canonical Podman secret names for the sp-portal deployment.
# Consumed by deploy.sh preflight (it verifies every required name exists
# in `podman secret ls`). One name per line; # comments allowed.
#
# name                          mounted at /run/secrets/<name>    required by
sp_portal_db_password            # app + worker (DML user sp_portal_app)
sp_portal_db_migrate_password    # migrate one-shot (DDL user sp_portal_migrate)
sp_portal_auth_secret            # app
sp_portal_altcha_secret          # app
sp_portal_smtp_password          # app + worker
sp_portal_stripe_secret_key      # app + worker
sp_portal_stripe_webhook_secret  # app only (webhook signature check)
sp_portal_download_secret        # app only (HMAC download URLs)
sp_portal_licence_signing_key    # app only (Ed25519 licence issuer key)
sp_portal_bundle_signing_key     # app only (Ed25519 offline-bundle key)
